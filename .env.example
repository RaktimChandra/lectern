# Lectern configuration. Copy to .env and fill in what you have.

# --- Writer model (drafts the lesson) ------------------------------------
# Set at least one key. If LLM_PROVIDER is empty, the first configured key is used
# in this order: anthropic, openai, gemini, openrouter.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=            # anthropic | openai | gemini | openrouter | ollama
LLM_MODEL=               # leave empty for the default, or e.g. claude-sonnet-5-5, gpt-4.1, gemini-2.5-flash

# --- Reviewer model (runs both QC layers) --------------------------------
# A different provider or model makes the review independent of the writer.
QC_PROVIDER=
QC_MODEL=                # e.g. claude-opus-5-5

# --- Research --------------------------------------------------------------
TAVILY_API_KEY=          # web search with page text (recommended)
BRAVE_API_KEY=           # web search fallback (optional)
YOUTUBE_API_KEY=         # YouTube Data API v3 (needed for video recommendations)
GOOGLE_BOOKS_API_KEY=    # optional; books also work without a key

# --- Lesson ------------------------------------------------------------------
LESSON_MINUTES=45
READING_WORDS_PER_MINUTE=180
